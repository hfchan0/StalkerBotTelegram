# Comma-separated public accounts with explicit written permission to archive.
INSTAGRAM_USERNAMES=authorized_creator_one,authorized_creator_two

# Obtain the token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Private archive channel (-100...) and your personal alert chat ID.
TELEGRAM_CHANNEL_CHAT_ID=-1001234567890
TELEGRAM_ALERT_CHAT_ID=123456789

POLL_INTERVAL_MINUTES=20
# Default false: only Telegram /stories and /download commands contact Instagram.
SCHEDULED_MONITORING=false
# Stories are checked by default. Set true only when you also want posts/Reels.
MONITOR_POSTS_AND_REELS=false
# Pause this long after Instagram returns HTTP 429.
RATE_LIMIT_PAUSE_MINUTES=60
# Pause polling after this many consecutive session/authentication failures.
AUTH_FAILURE_LIMIT=3
RETENTION_DAYS=365
# Hard local archive cap: 15 GiB. Oldest media is removed first when exceeded.
MAX_ARCHIVE_BYTES=16106127360
DATA_DIR=/data
INSTAGRAM_COOKIES_PATH=/run/secrets/instagram-cookies.txt
LOG_LEVEL=INFO